#include <cstring>
#include <iomanip>
#include <iostream>
#include <string>

class BankAccount {
private:
    int accountNumber;
    char* holderName;
    double balance;

    static char* copyString(const char* src) {
        if (!src) {
            src = "";
        }
        std::size_t len = std::strlen(src);
        char* dest = new char[len + 1];
        std::memcpy(dest, src, len + 1);
        return dest;
    }

public:
    BankAccount(int accNum = 0, const char* name = "", double initialBalance = 0.0)
        : accountNumber(accNum),
          holderName(copyString(name)),
          balance(initialBalance >= 0.0 ? initialBalance : 0.0) {}

    BankAccount(const BankAccount& other)
        : accountNumber(other.accountNumber),
          holderName(copyString(other.holderName)),
          balance(other.balance) {}

    BankAccount& operator=(const BankAccount& other) {
        if (this == &other) {
            return *this;
        }

        char* newName = copyString(other.holderName);
        delete[] holderName;

        holderName = newName;
        accountNumber = other.accountNumber;
        balance = other.balance;
        return *this;
    }

   ~BankAccount() {
        delete[] holderName;
    }

       BankAccount& operator+=(double amount) {
        if (amount > 0.0) {
            balance += amount;
        } else {
            std::cerr << "Error: Deposit amount must be positive.\n";
        }
        return *this;
    }

    BankAccount& operator-=(double amount) {
        if (amount <= 0.0) {
            std::cerr << "Error: Withdrawal amount must be positive.\n";
        } else if (amount > balance) {
            std::cerr << "Error: Insufficient funds.\n";
        } else {
            balance -= amount;
        }
        return *this;
    }

        bool operator==(const BankAccount& other) const {
        return accountNumber == other.accountNumber;
    }

    bool operator<(const BankAccount& other) const {
        return balance < other.balance;
    }

    bool operator>(const BankAccount& other) const {
        return balance > other.balance;
    }

        static void printAccount(const BankAccount& account) {
        std::cout << "Account Number: " << account.accountNumber << "\n"
                  << "Holder Name:    " << account.holderName << "\n"
                  << "Balance:        $" << std::fixed << std::setprecision(2)
                  << account.balance << "\n";
    }

    static BankAccount createAccountFromInput() {
        int accNum = 0;
        std::string name;
        double initialBalance = 0.0;

        std::cout << "Enter account number: ";
        std::cin >> accNum;

        std::cout << "Enter holder name: ";
        std::cin.ignore();
        std::getline(std::cin, name);

        std::cout << "Enter initial balance: ";
        std::cin >> initialBalance;

        return BankAccount(accNum, name.c_str(), initialBalance);
    }
};

#include <iostream>
#include <vector>
#include <memory>
#include <string>
#include <iomanip>

class BankAccount {
protected:
    std::string accountHolder;
    double balance;

public:
    BankAccount(const std::string& holder, double initialBalance)
        : accountHolder(holder), balance(initialBalance) {}

    virtual ~BankAccount() = default;

    virtual void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            std::cout << "Deposited $" << amount << ". New balance: $" << balance << "\n";
        } else {
            std::cout << "Invalid deposit amount.\n";
        }
    }

    virtual bool withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            std::cout << "Withdrew $" << amount << ". New balance: $" << balance << "\n";
            return true;
        }
        std::cout << "Insufficient funds or invalid amount.\n";
        return false;
    }

    virtual void display() const {
        std::cout << "Holder: " << accountHolder 
                  << " | Balance: $" << std::fixed << std::setprecision(2) << balance << "\n";
    }

    std::string getHolder() const { return accountHolder; }
    double getBalance() const { return balance; }
};

class CheckingAccount : public BankAccount {
private:
    double transactionFee;

public:
    CheckingAccount(const std::string& holder, double initialBalance, double fee)
        : BankAccount(holder, initialBalance), transactionFee(fee) {}

    bool withdraw(double amount) override {
        double totalAmount = amount + transactionFee;
        if (amount > 0 && totalAmount <= balance) {
            balance -= totalAmount;
            std::cout << "Withdrew $" << amount << " (+ $" << transactionFee 
                      << " fee). New balance: $" << balance << "\n";
            return true;
        }
        std::cout << "Insufficient funds to cover withdrawal and $" << transactionFee << " fee.\n";
        return false;
    }

    void display() const override {
        std::cout << "[Checking] ";
        BankAccount::display();
    }
};

class SavingsAccount : public BankAccount {
private:
    double interestRate;

public:
    SavingsAccount(const std::string& holder, double initialBalance, double rate)
        : BankAccount(holder, initialBalance), interestRate(rate) {}

    void calculateInterest() {
        double interest = balance * (interestRate / 100.0);
        balance += interest;
        std::cout << "Added $" << interest << " interest (" << interestRate 
                  << "%). New balance: $" << balance << "\n";
    }

    void display() const override {
        std::cout << "[Savings]  ";
        BankAccount::display();
    }
};

int main() {

    std::vector<std::unique_ptr<BankAccount>> accounts;

    accounts.push_back(std::make_unique<CheckingAccount>("Alice", 1000.00, 2.50));
    accounts.push_back(std::make_unique<SavingsAccount>("Bob", 2000.00, 3.5));

    std::cout << "--- Polymorphic Withdrawal Demonstration ---\n";
    for (const auto& acc : accounts) {
        acc->display();
        acc->withdraw(100.00); 
        std::cout << "\n";
    }

   int choice = 0;
    while (choice != 6) {
        std::cout << "\n--- Bank Menu ---\n"
                  << "1. Create Checking Account\n"
                  << "2. Create Savings Account\n"
                  << "3. Deposit\n"
                  << "4. Withdraw\n"
                  << "5. Apply Interest (Savings Accounts Only)\n"
                  << "6. Exit\n"
                  << "Enter choice: ";
        std::cin >> choice;

        if (choice == 1 || choice == 2) {
            std::string name;
            double initBal, extra;
            std::cout << "Enter account holder name: ";
            std::cin.ignore();
            std::getline(std::cin, name);
            std::cout << "Enter initial balance: ";
            std::cin >> initBal;

            if (choice == 1) {
                std::cout << "Enter transaction fee: ";
                std::cin >> extra;
                accounts.push_back(std::make_unique<CheckingAccount>(name, initBal, extra));
            } else {
                std::cout << "Enter interest rate (%): ";
                std::cin >> extra;
                accounts.push_back(std::make_unique<SavingsAccount>(name, initBal, extra));
            }
            std::cout << "Account created successfully.\n";
        } 
        else if (choice >= 3 && choice <= 5) {
            if (accounts.empty()) {
                std::cout << "No accounts available.\n";
                continue;
            }

            for (size_t i = 0; i < accounts.size(); ++i) {
                std::cout << i << ": ";
                accounts[i]->display();
            }

            size_t index;
            std::cout << "Select account index: ";
            std::cin >> index;

            if (index >= accounts.size()) {
                std::cout << "Invalid account index.\n";
                continue;
            }

            if (choice == 3) {
                double amt;
                std::cout << "Enter deposit amount: ";
                std::cin >> amt;
                accounts[index]->deposit(amt);
            } 
            else if (choice == 4) {
                double amt;
                std::cout << "Enter withdrawal amount: ";
                std::cin >> amt;
                accounts[index]->withdraw(amt); 
            } 
            else if (choice == 5) {

               SavingsAccount* savings = dynamic_cast<SavingsAccount*>(accounts[index].get());
                if (savings) {
                    savings->calculateInterest();
                } else {
                    std::cout << "Selected account is not a Savings Account.\n";
                }
            }
        }
    }

    return 0;
}
